# окружение
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# данные проекта — никогда не в репозиторий
storage/
fixtures/*
!fixtures/README.md
!fixtures/*.json

# секреты
.env
*.key

# фронтенд
node_modules/
frontend/dist/

# система
.DS_Store

# личные настройки Claude Code
.claude/settings.local.json

# навыки из маркетплейса — инструменты для работы, а не часть программы.
# Ставятся отдельно и лицензированы своими авторами.
.agents/

# Кэш инкрементальной сборки TypeScript — меняется при каждой сборке
frontend/tsconfig.tsbuildinfo

# Служебные файлы autoskills во вложенных каталогах
frontend/.claude/
frontend/skills-lock.json

# Веса YOLOX (20 МБ) не в репозитории: в отличие от 230-килобайтной модели
# лиц, это заметный вес в каждом клоне ради ещё не доказавшего себя бэкенда.
assets/models/yolox_tiny.onnx
